// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum für Auftragsphasen
enum AuftragsPhase {
  // Auftrag erhalten und grobe Zeitschiene erstellt
  ERSTKONTAKT
  // Auf Basis der Produktvariante und Baugruppen eine grobe Zeitschiene erstellt
  GROBTERMINIERUNG
  // Produkt erhalten und Inspektion + Reinigung durchführen
  INSPEKTION
  // Inspektionsergebnis ausgewertet und ggf. Anpassungen vorgenommen
  FEINTERMINIERUNG
  // Remontage-Operationen
  REMONTAGE
  // Reassembly-Operationen durchgeführt
  ABGESCHLOSSEN
}


// Enum für Upgrade-Typen
enum UpgradeTyp {
  PFLICHT
  WUNSCH
  KOMBINIERT
}

// Enum für Liefertermin-Typen
enum LieferterminTyp {
  GROB_ZEITSCHIENE    // Erste Schätzung bei Erstkontakt
  GROBTERMIN          // Nach Grobterminierung
  FEINTERMIN          // Nach Inspektion und Feinterminierung
}

// Enum für Zustand
enum ZustandsTyp {
  SEHR_GUT
  GUT
  MITTEL
  SCHLECHT
  DEFEKT
}

enum Baugruppenart {
  basic
  premium
  basicAndPremium
}


// Reassembly Factory
model ReassemblyFactory {
  id                    String              @id @default(cuid())
  name                  String
  kapazität             Int                 // Begrenzt wie viele Produkte gleichzeitig in der Halle sein können
  auftraege             Auftrag[]
  produkte              Produkt[]           // Produkte der Reassembly Factory
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}


// Kunde
model Kunde {
  id        String     @id @default(cuid())
  vorname   String
  nachname  String
  email     String?    @unique
  telefon   String?
  adresse   String?
  auftraege Auftrag[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Auftrag
model Auftrag {
  id                    String               @id @default(cuid())
  kunde                 Kunde                @relation(fields: [kundeId], references: [id])
  kundeId               String
  produktvariante       Produktvariante      @relation(fields: [produktvarianteId], references: [id])
  produktvarianteId     String
  phase                 AuftragsPhase        @default(ERSTKONTAKT)
  upgradeTyp            UpgradeTyp           // Wenn die Produktvariante Pflichtupgrades besitzt dann PFLICHT, sonst KOMBINIERT
  factory               ReassemblyFactory    @relation(fields: [factoryId], references: [id])
  factoryId             String
  liefertermine         Liefertermin[]
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

// Liefertermin
model Liefertermin {
  id           String          @id @default(cuid())
  auftrag      Auftrag         @relation(fields: [auftragId], references: [id])
  auftragId    String
  typ          LieferterminTyp
  datum        DateTime
  istAktuell   Boolean         @default(true) // Markiert den aktuell gültigen Termin
  bemerkung    String?         // Grund für Änderung etc.
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

// Produkt zb "Volkswagen Polo"
model Produkt {
  id              String              @id @default(cuid())
  bezeichnung     String              // z.B. "Volkswagen Polo"
  seriennummer    String              @unique
  factory         ReassemblyFactory?  @relation(fields: [factoryId], references: [id])
  factoryId       String?
  zustand         ZustandsTyp?        // Wird über die Baugruppen bestimmt
  varianten       Produktvariante[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

// Produktvariante zb "Polo GTI 2017"
model Produktvariante {
  id              String            @id @default(cuid())
  produkt         Produkt           @relation(fields: [produktId], references: [id])
  produktId       String
  bezeichnung     String            // z.B. "Polo GTI 2017"
  links           Json              // JointJS Verbindungen zwischen Baugruppen
  baugruppen      Baugruppe[]       // Welche Baugruppen gehören zu dieser Variante
  auftraege       Auftrag[]         // Alle Aufträge für diese Produktvariante
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}


// Baugruppe: Definition einer Baugruppe (z.B. "Motor V6", "Getriebe Automatik")
model Baugruppe {
  id                   String               @id @default(cuid())
  bezeichnung          String
  artikelnummer        String               @unique
  baugruppenart        Baugruppenart
  durchlaufzeit        Int?                 // in Minuten. Wie lange dauert es, diese Baugruppe zu remontieren?
  volumen              Float?               // in m³
  varianten            Produktvariante[]  
  prozesse             Prozess[]            // Prozesse die dieser Baugruppe zugeordnet sind
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}


// Prozess: Operationen wie montieren, einölen, schleifen etc.
model Prozess {
  id                   String               @id @default(cuid())
  name                 String               // z.B. "Montieren", "Einölen", "Schleifen"
  baugruppen           Baugruppe[]          // Baugruppen denen dieser Prozess zugeordnet ist
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}
